{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/evidence-record-1.0.0.json",
  "title": "Evidence Record 1.0.0",
  "type": "object",
  "required": ["schemaVersion", "evidenceId", "evalId", "correlationId", "expected", "observed", "verdict", "residualRisks"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "evidenceId": {"type": "string", "minLength": 1},
    "evalId": {"type": "string", "minLength": 1},
    "correlationId": {"type": "string", "minLength": 1},
    "expected": {
      "type": "object",
      "required": ["artifacts", "assertions"],
      "properties": {"artifacts": {"type": "array", "items": {"type": "string"}}, "assertions": {"type": "array", "items": {"type": "string"}}},
      "additionalProperties": false
    },
    "observed": {
      "type": "object",
      "required": ["artifacts", "durableStatus", "notifyAfterCommit", "statusApi", "testsPassed", "testsFailed"],
      "properties": {
        "artifacts": {"type": "array", "items": {"type": "string"}},
        "durableStatus": {"enum": ["queued", "running", "completed", "failed", "cancelled"]},
        "notifyAfterCommit": {"type": "boolean"},
        "statusApi": {"enum": ["consistent", "inconsistent", "notChecked"]},
        "testsPassed": {"type": "integer", "minimum": 0},
        "testsFailed": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "verdict": {"enum": ["PASS", "FAIL", "INCONCLUSIVE"]},
    "residualRisks": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
